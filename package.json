{
  "name": "kokoro-cli",
  "module": "index.ts",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "smoke:model-cache": "KOKORO_MODEL_CACHE_TEST=1 bun test --timeout 300000 tests/model-cache.integration.test.ts",
    "smoke:standalone": "KOKORO_STANDALONE_TEST=1 bun test --timeout 600000 tests/standalone.integration.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.5.1",
    "kokoro-js": "1.2.1",
    "onnxruntime-node": "1.21.0",
    "onnxruntime-web": "1.21.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "onnxruntime-web": "1.21.0"
  },
  "patchedDependencies": {
    "@huggingface/transformers@3.5.1": "patches/@huggingface%2ftransformers@3.5.1.patch",
    "kokoro-js@1.2.1": "patches/kokoro-js@1.2.1.patch",
    "onnxruntime-node@1.21.0": "patches/onnxruntime-node@1.21.0.patch"
  }
}
