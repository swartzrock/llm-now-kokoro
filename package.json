{
  "name": "llm-now-kokoro",
  "version": "0.1.0",
  "private": true,
  "module": "index.ts",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "smoke:offline": "bun scripts/run-offline-inference-smoke.ts",
    "smoke:architecture:prepare": "bun scripts/prepare-architecture-smoke.ts",
    "smoke:architecture": "bun scripts/run-architecture-smoke.ts",
    "release:build": "bun scripts/build-release.ts",
    "release:test": "bun test scripts/native-inspection.test.ts scripts/release-manifest.test.ts scripts/release-validation.test.ts scripts/release-security.test.ts tests/model-cache.integration.test.ts tests/standalone.integration.test.ts",
    "release:validate": "bun run release:build && bun scripts/validate-release.ts",
    "release:validate:unsigned": "bun scripts/validate-release.ts",
    "release:validate:collected": "bun scripts/validate-collected-release.ts",
    "release:metadata": "bun scripts/generate-release-metadata.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.5.1",
    "kokoro-js": "1.2.1",
    "onnxruntime-node": "1.21.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "onnxruntime-web": "1.21.0"
  },
  "patchedDependencies": {
    "@huggingface/transformers@3.5.1": "patches/@huggingface%2ftransformers@3.5.1.patch",
    "kokoro-js@1.2.1": "patches/kokoro-js@1.2.1.patch",
    "onnxruntime-node@1.21.0": "patches/onnxruntime-node@1.21.0.patch"
  }
}
